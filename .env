# SisyphusGate Base Directory (optional)
# Unraid users can set this to: /mnt/user/appdata/sisyphusgate
# Leave empty to use current directory
# SISYPHUSGATE_BASE=/mnt/user/appdata/sisyphusgate

# Docker Image
SISYPHUSGATE_IMAGE=ghcr.io/refreshcoder/sisyphusgate:latest

# Ports
SISYPHUSGATE_SSH_PORT=2222
SISYPHUSGATE_TELNET_PORT=2323
SISYPHUSGATE_HTTP_PORT=8080

# Logging
SISYPHUSGATE_LOG_LEVEL=INFO

# Tarpit Settings
TARPIT_DELAY_MS=10000
TARPIT_MAX_CLIENTS=4096
